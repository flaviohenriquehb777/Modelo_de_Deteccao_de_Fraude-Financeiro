# =============================================================================
# .gitignore — arquivos que NAO devem ser versionados pelo Git
# -----------------------------------------------------------------------------
# Convencao do projeto: dados, modelos e artefatos derivados sao versionados
# exclusivamente pelo DVC (ver dvc.yaml). O Git guarda apenas codigo, configs,
# metricas leves e documentos.
# =============================================================================

# --- Notebooks ---
.ipynb_checkpoints/

# --- Python ---
__pycache__/
*.pyc
*.pyo

# --- Ambientes virtuais ---
.venv/
venv/

# --- Segredos e configuracoes locais (nunca versionar) ---
.env
.env.*
.dvc/config.local

# --- Rastreamento local do MLflow (o resumo publico fica em reports/) ---
mlruns/

# --- Caches de ferramentas ---
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Arquivos de sistema operacional ---
.DS_Store
Thumbs.db

# --- Artefatos de ferramentas locais ---
.trae/
scripts/
